# Local development settings for docker-compose.yml.
# Copy to .env to change them. These values are for a developer's own machine
# only: never reuse them anywhere else. Real secrets live in the host's secret
# store, never in this repository.

COMPOSE_PROJECT_NAME=wasl

# PostgreSQL
POSTGRES_USER=wasl
POSTGRES_PASSWORD=wasl-local-only
POSTGRES_DB=wasl
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Object storage (SeaweedFS, S3-compatible).
# The access key and secret are set in infra/seaweedfs/s3.json.
S3_PORT=8333

# Mail catcher (Mailpit)
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
